# Create a project at https://www.sanity.io/manage — then copy the Project ID here.
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# Optional: read token for private datasets or CI builds (Settings → API → Tokens, Viewer role).
# Never commit the real token. Do not use Editor tokens in public site code.
SANITY_READ_TOKEN=

# Used by Sanity Studio (studio/.env) — same project ID:
# SANITY_STUDIO_PROJECT_ID=your_project_id
# SANITY_STUDIO_DATASET=production
